# Dashboard → Developers → API keys. A test key: nothing real moves.
PERLY_PAY_SECRET_KEY=sk_test_...
# Printed by `npm run setup` (the price is the pack; the buyer's top-up page lists every pack of the product)
PERLY_PAY_CREDITS_PRODUCT_ID=
PERLY_PAY_CREDITS_PRICE_ID=
# From the webhook endpoint (Dashboard → Developers → Webhooks), for "credits added" messages. Optional.
PERLY_PAY_WEBHOOK_SECRET=
# Only against a local Perly Pay; unset means https://pay.perly.io
# PERLY_PAY_API=http://localhost:3200
PORT=8787
