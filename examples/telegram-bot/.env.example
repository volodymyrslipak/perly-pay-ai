# From @BotFather
TELEGRAM_BOT_TOKEN=
# Dashboard → Developers → API keys. A test key: nothing real moves.
PERLY_PAY_SECRET_KEY=sk_test_...
# Printed by `npm run setup`
PERLY_PAY_PRODUCT_ID=
PERLY_PAY_PRICE_ID=
# From the webhook endpoint (PUBLIC_URL=… npm run setup prints it)
PERLY_PAY_WEBHOOK_SECRET=
# The webhook listener's port
PORT=8788
# Only against a local Perly Pay; unset means https://pay.perly.io
# PERLY_PAY_API=http://localhost:3200
