# --- the seller's side (scripts/): your secret key, never shipped in the app ---
# Dashboard → Developers → API keys. A test key: nothing real moves.
PERLY_PAY_SECRET_KEY=sk_test_...

# --- the app's side (src/cli.ts): public values only ---
# Printed by `npm run setup`; a product id is public and fine to ship
PERLY_PAY_PRODUCT_ID=
# Only against a local Perly Pay; unset means https://pay.perly.io
# PERLY_PAY_API=http://localhost:3200
# Where the app keeps its activation (default ./.license.json)
# LICENSE_FILE=.license.json
