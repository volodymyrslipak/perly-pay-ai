// Next.js: app/api/webhooks/perly/route.ts (the parts specific to subscriptions)
const event = pay.webhooks.verify(await request.text(), request.headers.get("perly-signature"), process.env.PERLY_PAY_WEBHOOK_SECRET!);
switch (event.type) {
  case "invoice.fulfilled": {
    const invoice = event.data.object as { subscription: string | null; metadata: Record<string, string> };
    if (invoice.subscription) await saveSubscription(invoice.metadata.user_id, invoice.subscription); // yours
    break;
  }
  case "subscription.past_due":
    await notifyRenewalLate(event.object_id!); // yours: "your renewal is due"
    break;
  case "subscription.ended":
    await downgrade(event.object_id!); // yours
    break;
}
